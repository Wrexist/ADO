# ai-control-center — copy to .env (gitignored). Server binds 127.0.0.1 only.
GITHUB_TOKEN=            # PAT: repo + actions:read
ANTHROPIC_API_KEY=       # used ONLY by the intent parser + analyzer (runner uses Claude Code's own auth)
ACC_TOKEN=               # shared secret for mutating endpoints — openssl rand -hex 24
PROJECT_DIRS=~/dev       # comma-separated list of dirs containing your repos
PORT=8787
WEB_ORIGIN=http://localhost:5173
DB_PATH=./data/acc.sqlite
