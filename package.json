{
  "name": "ai-development-os",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first mission control for the Wrexist portfolio \u2014 the AI Development OS wedge (AI Control Center).",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/build-process-host.mjs && node scripts/bootstrap-env.mjs",
    "predev": "node scripts/build-process-host.mjs && node scripts/bootstrap-env.mjs",
    "dev": "concurrently -n server,web -c magenta,cyan \"npm run dev -w @ado/server\" \"npm run dev -w @ado/web\"",
    "demo": "concurrently -n server,web -c magenta,cyan \"npm run start -w @ado/server -- --demo\" \"npm run dev -w @ado/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "node scripts/build-process-host.mjs",
    "prebuild": "node scripts/build-process-host.mjs",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:native-profile": "node scripts/probe-native-profile.mjs",
    "smoke:packaged-profile": "node --import tsx scripts/probe-packaged-profile.mts",
    "autostart": "bash scripts/install-autostart.sh",
    "restore": "node --import tsx scripts/restore.mts",
    "app:windows": "node scripts/build-windows-app.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^5.0.2"
  }
}
